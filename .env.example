# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider (provider-agnostic — swap without changing business logic)
#
# Supported values for LLM_PROVIDER:
#   openai        → OpenAI or OpenAI-compatible (Groq, OpenRouter, local)
#   anthropic     → Anthropic Claude
#
# For cheap/free dev: use Groq (set PROVIDER=openai, point BASE_URL to Groq)
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_API_KEY_BACKUP=your-backup-key-here   # optional — auto-used when primary hits quota
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-8b-8192
LLM_MAX_TOKENS=2048

# Alternative examples:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-haiku-4-5-20251001

# LLM_PROVIDER=openai  (OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=mistralai/mistral-7b-instruct

# ─────────────────────────────────────────────────────────────────────────────
# Grok Enhancement Layer (xAI — secondary, non-blocking)
#
# Grok runs AFTER the deterministic pipeline and enhances:
#   - Positioning summary
#   - Recommendation explanations
#   - FAQ draft answers
#   - Quick wins vs bigger lifts framing
#
# Grok may improve prose only.
# Grok must not modify canonical business fields, detected signals,
# scores, or deterministic recommendation ranking.
#
# If disabled, unconfigured, or failed, the report renders from
# deterministic content only.
#
# Grok is skipped entirely when MOCK_LLM=true.
# ─────────────────────────────────────────────────────────────────────────────
GROK_ENABLED=true

# Option A — xAI Grok (requires billing at console.x.ai)
XAI_API_KEY=your-xai-api-key-here
GROK_MODEL=grok-4-1-fast

# Option B — Groq free tier (reuses LLM_API_KEY + LLM_BASE_URL by default,
# or set GROK_API_KEY / GROK_BASE_URL / GROK_MODEL to override independently)
# GROK_BASE_URL=https://api.groq.com/openai/v1
# GROK_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to skip all LLM calls (base + Grok) and use deterministic content
MOCK_LLM=false
