# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider (provider-agnostic — swap without changing business logic)
#
# Supported values for LLM_PROVIDER:
#   openai        → OpenAI or OpenAI-compatible (Groq, OpenRouter, local)
#   anthropic     → Anthropic Claude
#
# For cheap/free dev: use Groq (set PROVIDER=openai, point BASE_URL to Groq)
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-8b-8192
LLM_MAX_TOKENS=2048

# Alternative examples:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-haiku-4-5-20251001

# LLM_PROVIDER=openai  (OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=mistralai/mistral-7b-instruct

# ─────────────────────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" to skip LLM calls and use mock summaries (useful for UI dev)
MOCK_LLM=false
